      "email": "paolo@bitfinex.com"
    },
    {
      "name": "vigan.abd",
      "email": "vigan.abdurrahmani@bitfinex.com"
    }
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/bitfinexcom/lib-js-util-marshal/issues"
  },
  "homepage": "https://github.com/bitfinexcom/lib-js-util-marshal#readme",
  "engines": {
    "node": ">=22.0"
  },
  "devDependencies": {
    "@bitfinex/lint-js": "^1.1.0",
    "brittle": "^4.5.0"
  }
