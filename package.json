    "test:code": "NODE_ENV=test brittle-node ./test/*.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfinexcom/lib-js-util-marshal.git"
  },
  "keywords": [
    "ruby",
    "marshal",
    "buffer",
    "serialization",
    "object marshaling",
    "marshaling"
  ],
  "author": {
